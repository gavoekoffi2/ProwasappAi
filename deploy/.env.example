# Production env for the VPS — copy to .env and fill in real values.
# Database is on Supabase. Replace DATABASE_URL with the pooler URL.

NODE_ENV=production
PORT=4000
APP_URL=https://prowasappai.netlify.app
CORS_ORIGINS=https://prowasappai.netlify.app
TRUST_PROXY=true

# Supabase Postgres (pooler, transaction mode + Prisma).
DATABASE_URL=postgresql://prowasapp_app.aczgwnarwzbdhggzmaix:CHANGE_ME@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_32_BYTES_HEX
JWT_EXPIRES_IN=7d
AUTH_RATE_LIMIT_PER_MIN=20

# LLM — leave empty until you have a key; auth/register still works without.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GITHUB_TOKEN=
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=600
AI_CONTEXT_TURNS=10
AI_RAG_TOP_K=4
AI_CONFIDENCE_THRESHOLD=0.55

# Voice (optional — leave empty to disable)
STT_PROVIDER=openai
STT_MODEL=whisper-1
GROQ_API_KEY=
TTS_PROVIDER=none
TTS_MODEL=tts-1
TTS_VOICE=alloy
ELEVENLABS_API_KEY=

WA_SESSIONS_DIR=/app/wa_sessions

BILLING_PROVIDER=manual
PLAN_STARTER_MSG_LIMIT=1000
PLAN_PRO_MSG_LIMIT=10000
PLAN_BUSINESS_MSG_LIMIT=50000

UPLOAD_MAX_MB=20
