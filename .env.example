# ───────────────── App ─────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
# Comma-separated extra CORS origins (leave blank to only allow APP_URL).
CORS_ORIGINS=
TRUST_PROXY=false
API_URL=http://localhost:4000
PORT=4000

# ─────────────── Database ──────────────
POSTGRES_USER=prowasapp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=prowasapp
DATABASE_URL=postgresql://prowasapp:change-me@postgres:5432/prowasapp?schema=public

# ─────────────── Redis ─────────────────
REDIS_URL=redis://redis:6379

# ─────────────── Auth ──────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
AUTH_RATE_LIMIT_PER_MIN=20

# ─────────────── AI provider ───────────
# Options:
#   openai          — https://api.openai.com/v1 + OPENAI_API_KEY
#   github-models   — https://models.github.ai/inference + GITHUB_TOKEN
#                     (free tier available; see https://docs.github.com/github-models)
#   azure / local / custom — set OPENAI_BASE_URL to the compatible endpoint
LLM_PROVIDER=openai

# For LLM_PROVIDER=openai (or any OpenAI-compatible with an API key):
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# For LLM_PROVIDER=github-models — paste your GitHub PAT here
# (fine-grained, models:read permission). DO NOT COMMIT this value.
GITHUB_TOKEN=
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference

# Model identifiers. For GitHub Models the `openai/gpt-4o-mini` form is
# the inference-API catalog name; check the GH Models catalog for the
# exact IDs you can use.
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

AI_TEMPERATURE=0.3
AI_MAX_TOKENS=600
AI_CONTEXT_TURNS=10
AI_RAG_TOP_K=4
AI_CONFIDENCE_THRESHOLD=0.55

# ─────────────── Voice ─────────────────
STT_PROVIDER=openai              # openai | local
STT_MODEL=whisper-1
TTS_PROVIDER=openai              # openai | elevenlabs | none
TTS_MODEL=tts-1
TTS_VOICE=alloy
ELEVENLABS_API_KEY=

# ─────────────── WhatsApp ──────────────
WA_SESSIONS_DIR=/app/wa_sessions

# ─────────────── Billing ───────────────
BILLING_PROVIDER=manual          # manual | stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─────────────── Limits ────────────────
PLAN_STARTER_MSG_LIMIT=1000
PLAN_PRO_MSG_LIMIT=10000
PLAN_BUSINESS_MSG_LIMIT=50000
UPLOAD_MAX_MB=20
TENANT_STORAGE_MAX_MB=200

# ─────────────── Frontend ──────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
