# ───────────────── App ─────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000

# ─────────────── Database ──────────────
POSTGRES_USER=prowasapp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=prowasapp
DATABASE_URL=postgresql://prowasapp:change-me@postgres:5432/prowasapp?schema=public

# ─────────────── Redis ─────────────────
REDIS_URL=redis://redis:6379

# ─────────────── Auth ──────────────────
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ─────────────── AI ────────────────────
# The default provider is OpenAI-compatible. Point OPENAI_BASE_URL at any
# OpenAI-compatible endpoint (Ollama, Together, Groq, local vLLM…).
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=600
AI_CONTEXT_TURNS=10
AI_RAG_TOP_K=4
AI_CONFIDENCE_THRESHOLD=0.55

# ─────────────── Voice ─────────────────
STT_PROVIDER=openai              # openai | local
STT_MODEL=whisper-1
TTS_PROVIDER=openai              # openai | elevenlabs | none
TTS_MODEL=tts-1
TTS_VOICE=alloy
ELEVENLABS_API_KEY=

# ─────────────── WhatsApp ──────────────
WA_SESSIONS_DIR=/app/wa_sessions

# ─────────────── Billing ───────────────
BILLING_PROVIDER=manual          # manual | stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─────────────── Limits ────────────────
PLAN_STARTER_MSG_LIMIT=1000
PLAN_PRO_MSG_LIMIT=10000
PLAN_BUSINESS_MSG_LIMIT=50000

# ─────────────── Frontend ──────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
